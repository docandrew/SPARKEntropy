with "sparkentropy.gpr";

project Test_Entropy is
   for Source_Dirs use ("tests");
   for Object_Dir use "obj/tests";
   for Create_Missing_Dirs use "True";
   --  test_keccak.adb removed: it KAT-tested the in-house SHAKE-256
   --  implementation we replaced with libkeccak. libkeccak ships
   --  upstream NIST KAT tests for SHAKE-256 in its own test suite.
   for Main use ("test_entropy.adb", "dump_entropy.adb", "dump_raw.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-g", "-gnatQ");
   end Compiler;
end Test_Entropy;
