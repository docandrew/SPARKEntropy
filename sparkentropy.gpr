with "config/sparkentropy_config.gpr";

project SPARKEntropy is
   type Host_Arch_Type is ("x86_64", "aarch64", "unsupported");
   Host_Arch : Host_Arch_Type :=
     external ("SPARKENTROPY_HOST_ARCH", "x86_64");

   Timer_Source_Dirs := ("src/timer/x86_64");

   case Host_Arch is
      when "aarch64" =>
         Timer_Source_Dirs := ("src/timer/aarch64");
      when "x86_64" =>
         Timer_Source_Dirs := ("src/timer/x86_64");
      when others =>
         Timer_Source_Dirs := ("src/timer/unsupported");
   end case;

   for Source_Dirs use ("src") & Timer_Source_Dirs;
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";

   package Compiler is
      --  No optimisation level is set here, so GCC's value-range propagation
      --  does not run; -fno-tree-vrp keeps it off if one is ever added. GNAT
      --  15.2 and 16.1 miscompile with it: measured 2026-09-24, SPARKNaCl's
      --  SHA-256 gave a wrong digest for every input at -O2 without this flag.
      for Default_Switches ("Ada") use
        ("-g", "-gnatwa", "-gnatQ", "-gnatw.X", "-fno-tree-vrp");
   end Compiler;
end SPARKEntropy;
